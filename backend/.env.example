# Server Configuration
PORT=3000
JWT_SECRET=replace_me

# MySQL/XAMPP Database Connection
# Update DB_HOST to the IP address of the computer running XAMPP
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=loan_system

# Network Configuration
# SERVER_IP: IP address where this Node.js server will run
# FRONTEND_ORIGIN: URL where your React frontend will run (for CORS)
SERVER_IP=localhost
FRONTEND_ORIGIN=http://localhost:5173

# Network Examples:
# For localhost (everything on same computer):
#   DB_HOST=127.0.0.1
#   SERVER_IP=localhost
#   FRONTEND_ORIGIN=http://localhost:5173

# For network access (different computers):
#   DB_HOST=192.168.1.100 (IP of computer running XAMPP)
#   SERVER_IP=192.168.1.150 (IP of this computer)
#   FRONTEND_ORIGIN=http://192.168.1.150:5173

# Quick Setup:
# 1. Use the network configuration scripts to switch between setups
# 2. Run: switch-network.bat list (Windows) or ./switch-network.sh list (Linux/Mac)
# 3. Run: switch-network.bat [network-name] to apply a configuration
