# Frontend Environment Variables
# Point this to your backend API base (no trailing slash needed)
VITE_API_URL=http://localhost:3000/api

# Network Configuration Examples:
# For localhost (backend on same computer):
#   VITE_API_URL=http://localhost:3000/api

# For network access (backend on different computer):
#   VITE_API_URL=http://192.168.1.150:3000/api (replace with backend computer's IP)

# Common Network Scenarios:
# Home WiFi: VITE_API_URL=http://192.168.1.xxx:3000/api  
# Office WiFi: VITE_API_URL=http://10.1.xxx.xxx:3000/api
# Mobile Hotspot: VITE_API_URL=http://192.168.137.xxx:3000/api

# Quick Setup:
# 1. Use the network configuration scripts in the project root
# 2. Run: switch-network.bat list (Windows) or ./switch-network.sh list (Linux/Mac)
# 3. Run: switch-network.bat [network-name] to automatically configure this file
# 4. Restart the dev server after switching: npm run dev
